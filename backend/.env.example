# Copy this file to .env and fill in your values.

# Prisma (required)
DATABASE_URL="postgresql://postgres:112233@HOST:5432/DB_NAME?schema=public"

# Nest
PORT=3000
CLIENT_URL="http://localhost:3000,http://localhost:5173"

# OpenRouter
OPEN_ROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_SITE_URL="http://localhost:5173"
OPENROUTER_APP_NAME="Krishok.ai"
# Priority order: OpenRouter automatically tries the next model when one fails.
OPENROUTER_MODELS="google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-120b:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,openrouter/free"

