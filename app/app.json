{
  "expo": {
    "name": "Krishok.ai",
    "slug": "krishok-ai",
    "version": "1.0.0",

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "experiments": {
      "tsconfigPaths": true
    },

    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ফসলের ছবি নির্বাচন করতে Krishok.ai-কে অনুমতি দিন।",
          "cameraPermission": "ফসলের ছবি তুলতে Krishok.ai-কে ক্যামেরা ব্যবহারের অনুমতি দিন।"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "কৃষি প্রশ্ন বলার জন্য Krishok.ai-কে মাইক্রোফোন ব্যবহারের অনুমতি দিন।",
          "speechRecognitionPermission": "আপনার কথা লেখায় রূপান্তর করতে Krishok.ai-কে অনুমতি দিন।"
        }
      ]
    ],

    "orientation": "portrait",
    "icon": "./assets/icon.png",

    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "xyz.krishokai.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
